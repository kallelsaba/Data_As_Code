"""
Dashboard as Code — DataOps Olist
==================================
Crée/actualise automatiquement, via l'API REST de Superset :
  - la base de données (si absente)
  - 4 datasets virtuels (SQL) : CA, Livraison, Satisfaction, Produits
  - les charts associés (repris des pages Dash existantes)
  - un dashboard unique avec 4 onglets

Idempotent : relancer le script met à jour l'existant au lieu de dupliquer.
Aucune action manuelle dans l'UI Superset n'est nécessaire.

Usage :
    pip install requests
    python superset_dashboard_as_code.py
"""

import requests

SUPERSET_URL = "http://superset:8088"   
USERNAME = "admin"
PASSWORD = "admin"

DB_NAME = "PostgreSQL DataOps"
SQLALCHEMY_URI = "postgresql+psycopg2://dataops:dataops@postgres:5432/dataops"

session = requests.Session()


# ------------------------------------------------------------------
# Authentification
# ------------------------------------------------------------------
def login():
    resp = session.post(
        f"{SUPERSET_URL}/api/v1/security/login",
        json={"username": USERNAME, "password": PASSWORD, "provider": "db", "refresh": True},
    )
    resp.raise_for_status()
    token = resp.json()["access_token"]
    session.headers.update({"Authorization": f"Bearer {token}"})

    csrf = session.get(f"{SUPERSET_URL}/api/v1/security/csrf_token/")
    csrf.raise_for_status()
    session.headers.update({
        "X-CSRFToken": csrf.json()["result"],
        "Referer": SUPERSET_URL,
    })


# ------------------------------------------------------------------
# Helpers génériques (idempotence : cherche par nom avant de créer)
# ------------------------------------------------------------------
def find_by_name(endpoint, name_field, name_value):
    q = f'(filters:!((col:{name_field},opr:eq,value:{name_value})))'
    resp = session.get(f"{SUPERSET_URL}/api/v1/{endpoint}/?q={q}")
    resp.raise_for_status()
    result = resp.json()["result"]
    return result[0]["id"] if result else None


def get_or_create_database():
    db_id = find_by_name("database", "database_name", DB_NAME)
    if db_id:
        return db_id
    resp = session.post(
        f"{SUPERSET_URL}/api/v1/database/",
        json={
            "database_name": DB_NAME,
            "sqlalchemy_uri": SQLALCHEMY_URI,
            "expose_in_sqllab": True,
        },
    )
    resp.raise_for_status()
    return resp.json()["id"]


def get_or_create_dataset(db_id, table_name, sql):
    ds_id = find_by_name("dataset", "table_name", table_name)
    payload = {
        "database": db_id,
        "table_name": table_name,
        "sql": sql,
        "schema": "silver",
    }
    if ds_id:
        session.put(f"{SUPERSET_URL}/api/v1/dataset/{ds_id}", json=payload).raise_for_status()
        return ds_id
    resp = session.post(f"{SUPERSET_URL}/api/v1/dataset/", json=payload)
    resp.raise_for_status()
    return resp.json()["id"]


def get_or_create_chart(name, viz_type, dataset_id, params):
    chart_id = find_by_name("chart", "slice_name", name)
    payload = {
        "slice_name": name,
        "viz_type": viz_type,
        "datasource_id": dataset_id,
        "datasource_type": "table",
        "params": str(params).replace("'", '"'),
    }
    if chart_id:
        session.put(f"{SUPERSET_URL}/api/v1/chart/{chart_id}", json=payload).raise_for_status()
        return chart_id
    resp = session.post(f"{SUPERSET_URL}/api/v1/chart/", json=payload)
    resp.raise_for_status()
    return resp.json()["id"]


def get_or_create_dashboard(title, chart_ids, tabs_layout):
    dash_id = find_by_name("dashboard", "dashboard_title", title)
    payload = {
        "dashboard_title": title,
        "position_json": build_position_json(tabs_layout),
        "published": True,
    }
    if dash_id:
        session.put(f"{SUPERSET_URL}/api/v1/dashboard/{dash_id}", json=payload).raise_for_status()
        return dash_id
    resp = session.post(f"{SUPERSET_URL}/api/v1/dashboard/", json=payload)
    resp.raise_for_status()
    dash_id = resp.json()["id"]
    for cid in chart_ids:
        session.post(f"{SUPERSET_URL}/api/v1/chart/{cid}", json={"dashboards": [dash_id]})
    return dash_id


def build_position_json(tabs_layout):
    """Construit une mise en page simple en onglets (Tabs) avec grille de charts."""
    import json as _json

    layout = {
        "DASHBOARD_VERSION_KEY": "v2",
        "ROOT_ID": {"type": "ROOT", "id": "ROOT_ID", "children": ["GRID_ID"]},
        "GRID_ID": {"type": "GRID", "id": "GRID_ID", "children": ["TABS_ID"]},
        "TABS_ID": {"type": "TABS", "id": "TABS_ID", "children": []},
    }
    for tab_name, chart_ids in tabs_layout.items():
        tab_id = f"TAB_{tab_name}"
        row_id = f"ROW_{tab_name}"
        layout["TABS_ID"]["children"].append(tab_id)
        layout[tab_id] = {"type": "TAB", "id": tab_id, "meta": {"text": tab_name}, "children": [row_id]}
        layout[row_id] = {"type": "ROW", "id": row_id, "children": []}
        for cid in chart_ids:
            chart_key = f"CHART_{cid}"
            layout[row_id]["children"].append(chart_key)
            layout[chart_key] = {
                "type": "CHART",
                "id": chart_key,
                "meta": {"chartId": cid, "width": 4, "height": 50},
            }
    return _json.dumps(layout)


# ------------------------------------------------------------------
# Définitions des datasets (repris des requêtes des pages Dash)
# ------------------------------------------------------------------
SQL_CA = """
    SELECT DISTINCT
        order_id, order_purchase_timestamp, order_total_value
    FROM silver.stg_orders
    WHERE order_purchase_timestamp IS NOT NULL
"""

SQL_LIVRAISON = """
    SELECT DISTINCT
        order_id, order_purchase_timestamp, total_delivery_days,
        delivery_delay_days, is_delivered_on_time
    FROM silver.stg_orders
    WHERE total_delivery_days IS NOT NULL
"""

SQL_SATISFACTION = """
    SELECT DISTINCT
        order_id, review_score, is_positive_review, is_negative_review, has_comment
    FROM silver.stg_orders
    WHERE review_score IS NOT NULL
"""

SQL_PRODUITS = """
    SELECT product_category_name, price, freight_value
    FROM silver.stg_orders
    WHERE product_category_name IS NOT NULL
"""


# ------------------------------------------------------------------
# Main
# ------------------------------------------------------------------
def main():
    login()
    db_id = get_or_create_database()

    ds_ca = get_or_create_dataset(db_id, "vw_ca", SQL_CA)
    ds_liv = get_or_create_dataset(db_id, "vw_livraison", SQL_LIVRAISON)
    ds_sat = get_or_create_dataset(db_id, "vw_satisfaction", SQL_SATISFACTION)
    ds_prod = get_or_create_dataset(db_id, "vw_produits", SQL_PRODUITS)

    orange = "#FF7A1A"

    # --- Onglet CA ---
    c_ca_total = get_or_create_chart(
        "CA total", "big_number_total", ds_ca,
        {"metric": {"expressionType": "SQL", "sqlExpression": "SUM(order_total_value)"}, "color_picker": {"r": 255, "g": 122, "b": 26}},
    )
    c_ca_nb = get_or_create_chart(
        "Nombre de commandes", "big_number_total", ds_ca,
        {"metric": {"expressionType": "SQL", "sqlExpression": "COUNT(DISTINCT order_id)"}},
    )
    c_ca_avg = get_or_create_chart(
        "Panier moyen", "big_number_total", ds_ca,
        {"metric": {"expressionType": "SQL", "sqlExpression": "AVG(order_total_value)"}},
    )
    c_ca_trend = get_or_create_chart(
        "Évolution du CA mensuel", "echarts_timeseries_line", ds_ca,
        {
            "x_axis": "order_purchase_timestamp",
            "time_grain_sqla": "P1M",
            "metrics": [{"expressionType": "SQL", "sqlExpression": "SUM(order_total_value)", "label": "CA"}],
            "color_scheme": "supersetColors",
        },
    )

    # --- Onglet Livraison ---
    c_liv_avg = get_or_create_chart(
        "Délai moyen de livraison", "big_number_total", ds_liv,
        {"metric": {"expressionType": "SQL", "sqlExpression": "AVG(total_delivery_days)"}},
    )
    c_liv_ontime = get_or_create_chart(
        "% livré à l'heure", "big_number_total", ds_liv,
        {"metric": {"expressionType": "SQL", "sqlExpression": "AVG(CASE WHEN is_delivered_on_time THEN 100.0 ELSE 0 END)"}},
    )
    c_liv_trend = get_or_create_chart(
        "Délai moyen par mois", "echarts_timeseries_line", ds_liv,
        {
            "x_axis": "order_purchase_timestamp",
            "time_grain_sqla": "P1M",
            "metrics": [{"expressionType": "SQL", "sqlExpression": "AVG(total_delivery_days)", "label": "Délai moyen"}],
        },
    )
    c_liv_hist = get_or_create_chart(
        "Distribution des retards/avances", "histogram", ds_liv,
        {"column": "delivery_delay_days", "bins": 40, "color_picker": {"r": 255, "g": 122, "b": 26}},
    )

    # --- Onglet Satisfaction ---
    c_sat_avg = get_or_create_chart(
        "Note moyenne", "big_number_total", ds_sat,
        {"metric": {"expressionType": "SQL", "sqlExpression": "AVG(review_score)"}},
    )
    c_sat_pos = get_or_create_chart(
        "% avis positifs", "big_number_total", ds_sat,
        {"metric": {"expressionType": "SQL", "sqlExpression": "AVG(CASE WHEN is_positive_review THEN 100.0 ELSE 0 END)"}},
    )
    c_sat_neg = get_or_create_chart(
        "% avis négatifs", "big_number_total", ds_sat,
        {"metric": {"expressionType": "SQL", "sqlExpression": "AVG(CASE WHEN is_negative_review THEN 100.0 ELSE 0 END)"}},
    )
    c_sat_pie = get_or_create_chart(
        "Répartition des notes", "pie", ds_sat,
        {"groupby": ["review_score"], "metric": "count", "color_scheme": "supersetColors"},
    )
    c_sat_bar = get_or_create_chart(
        "Nombre d'avis par note", "echarts_timeseries_bar", ds_sat,
        {"groupby": ["review_score"], "metrics": ["count"], "color_picker": {"r": 255, "g": 122, "b": 26}},
    )

    # --- Onglet Produits ---
    c_prod_ca = get_or_create_chart(
        "Top 10 catégories par CA", "echarts_timeseries_bar", ds_prod,
        {
            "groupby": ["product_category_name"],
            "metrics": [{"expressionType": "SQL", "sqlExpression": "SUM(price)", "label": "CA"}],
            "row_limit": 10, "orientation": "horizontal",
        },
    )
    c_prod_nb = get_or_create_chart(
        "Top 10 catégories par ventes", "echarts_timeseries_bar", ds_prod,
        {
            "groupby": ["product_category_name"],
            "metrics": [{"expressionType": "SQL", "sqlExpression": "COUNT(price)", "label": "Ventes"}],
            "row_limit": 10, "orientation": "horizontal",
        },
    )

    tabs_layout = {
        "Chiffre d'affaires": [c_ca_total, c_ca_nb, c_ca_avg, c_ca_trend],
        "Livraison": [c_liv_avg, c_liv_ontime, c_liv_trend, c_liv_hist],
        "Satisfaction": [c_sat_avg, c_sat_pos, c_sat_neg, c_sat_pie, c_sat_bar],
        "Produits": [c_prod_ca, c_prod_nb],
    }
    all_charts = [cid for group in tabs_layout.values() for cid in group]

    dash_id = get_or_create_dashboard("DataOps Olist — Pilotage", all_charts, tabs_layout)
    print(f"✅ Dashboard prêt : {SUPERSET_URL}/superset/dashboard/{dash_id}/")


if __name__ == "__main__":
    main()
